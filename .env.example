APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
# ملاحظة: يُفضَّل ضبط البريد من لوحة الإدارة → إعدادات النظام → البريد الإلكتروني (تتجاوز .env عند الحفظ)

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REFRESH_TOKEN=
GOOGLE_DRIVE_ACCESS_TOKEN=
GOOGLE_DRIVE_FOLDER=

VITE_APP_NAME="${APP_NAME}"

# ملاحظة: معظم متغيرات .env قابلة للإدارة من لوحة الإدارة → إعدادات النظام
# القيم المحفوظة في قاعدة البيانات تتجاوز .env عند التشغيل. الأسرار تُخزَّن مشفّرة.

MOYASAR_SECRET_KEY=
MOYASAR_PUBLISHABLE_KEY=
MOYASAR_WEBHOOK_SECRET=
MOYASAR_CURRENCY=SAR
# ملاحظة: يمكن ضبط Moyasar من لوحة الإدارة → إعدادات طرق الدفع (تتجاوز .env عند الحفظ)

# Microsoft Teams (اختياري — يُفضَّل ضبطها من لوحة الإدارة → Microsoft Teams)
TEAMS_TENANT_ID=
TEAMS_CLIENT_ID=
TEAMS_CLIENT_SECRET=
TEAMS_ORGANIZER_USER_ID=
TEAMS_REDIRECT_URI=
# TEAMS_AUTO_RECORD=true
# TEAMS_RECORDING_PUBLISH_MODE=manual
# TEAMS_RECORDING_RETENTION_DAYS=365

# Zoom Server-to-Server OAuth (يمكن ضبطها أيضاً من لوحة الإدارة → Zoom)
ZOOM_ENABLED=false
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_WEBHOOK_SECRET=
ZOOM_DEFAULT_HOST=
ZOOM_HOST_STRATEGY=central
ZOOM_AUTO_ATTENDANCE=true
ZOOM_SYNC_INTERVAL=15
ZOOM_LATE_MINUTES=10
ZOOM_MINIMUM_ATTENDANCE_PERCENT=0
ZOOM_MINIMUM_ATTENDANCE_MINUTES=1
ZOOM_REGISTRATION_REQUIRED=true
ZOOM_WAITING_ROOM=true
ZOOM_HOST_VIDEO=true
ZOOM_PARTICIPANT_VIDEO=false
ZOOM_MUTE_UPON_ENTRY=true
ZOOM_JOIN_BEFORE_HOST=false
ZOOM_ALLOW_MULTIPLE_DEVICES=false
ZOOM_AUDIO_MODE=both
ZOOM_JOIN_WINDOW_MINUTES=30
ZOOM_RECORDING_POLICY=automatic
ZOOM_RECORDING_DESTINATION=zoom
ZOOM_S3_DISK=s3
ZOOM_GOOGLE_DISK=google

# First-party platform analytics
# Geo provider: none|cloudflare|vercel|cloudfront|appengine|custom
# Enable only when all requests pass through the selected trusted proxy.
ANALYTICS_GEO_PROVIDER=none
ANALYTICS_HASH_SALT=
ANALYTICS_RETENTION_DAYS=180

# OpenAI — AI Support Assistant (server-side only; never expose to the browser)
OPENAI_API_KEY=
OPENAI_ORGANIZATION=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_TIMEOUT=45
OPENAI_MAX_TOKENS=1200
OPENAI_TEMPERATURE=0.35
OPENAI_SUPPORT_ENABLED=true
OPENAI_SUPPORT_HISTORY_LIMIT=12
OPENAI_SUPPORT_KNOWLEDGE_CHUNKS=6
OPENAI_SUPPORT_DAILY_LIMIT=80
OPENAI_SUPPORT_NAME_AR="مساعد منصة كن خبيراً"
OPENAI_SUPPORT_NAME_EN="Be Expert Assistant"
